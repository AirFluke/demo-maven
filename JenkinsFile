pipeline {
    agent any
    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'master', description: 'Enter Your Branch Name')
        choice(name: 'CHOICES', choices: ['one', 'two', 'three'], description: 'Choose Your branch')
    }
    stages {
        stage('Hello') {
            steps {
                echo 'Hello World'
            }
        }

        stage('Hi') {
            steps {
                echo 'Hi'
            }
        }

        stage('Hey') {
            steps {
                echo 'Hey there'
            }
        }
        stage("Git checkout"){
            steps{
                checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/$BRANCH_NAME']], extensions: [], gitTool: 'Default', userRemoteConfigs: [[credentialsId: 'git_login', url: 'https://github.com/AirFluke/demo-maven.git']])
                bat "echo $CHOICES $BRANCH_NAME"
                bat "dir"
            }
        }
        stage('Testing Hooks') {
            steps {
                echo 'Hook Tested Sucess there'
            }
        }
    }
}
