pipeline{
agent any

    stages{
        stage("Git Checkout"){
            steps{
                checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/master']], extensions: [], gitTool: 'Default', userRemoteConfigs: [[credentialsId: 'git_login', url: 'https://github.com/AirFluke/demo-maven.git']])
            }
        }

        stage("Validate"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn validate"
                }
            }

        }
        stage("compile"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn compile"
                }
            }

        }
        stage("test"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn test"
                }
            }
        }
        stage('SonarQube Analysis') {
            environment{
                sonarScan = tool "airfluke-scanner"
            }
            steps{
                withSonarQubeEnv('Airfluke-Sonarqube') {
                    bat "\"${sonarScan}\\bin\\sonar-scanner.bat\""
                }
            }

        }
        stage("package"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn package"
                }
            }

        }

        stage('Deploy to Artifactory') {
            steps {
                configFileProvider([configFile(fileId: '2f82de63-6117-45d8-a06c-7f9c93c76a5c', variable: 'MAVEN_SETTINGS')]) {
                    withMaven(
                        maven: 'Maven 3.9',
                        mavenSettingsFilePath: "${MAVEN_SETTINGS}"
                    ) {
                        bat "mvn deploy -s ${MAVEN_SETTINGS}"
                    }
                }
            }
        }


       stage('Deploy to Dev') {
           steps {
               withCredentials([sshUserPrivateKey(credentialsId: 'aws-ec2-key', keyFileVariable: 'SSH_KEY')]) {
                   bat '''
                   echo Deploying to EC2...

                   rem Copy the key to a safe temporary location
                   set "TEMP_KEY=%WORKSPACE%\\deploy_key.pem"
                   copy "%SSH_KEY%" "%TEMP_KEY%"

                   rem Restrict file permissions like chmod 600
                   icacls "%TEMP_KEY%" /inheritance:r /grant:r "%USERNAME%:R"

                   rem Run scp using the fixed key
                   scp -i "%TEMP_KEY%" -o StrictHostKeyChecking=no ^
                   target\\ibt-maven-1.0-SNAPSHOTS.jar ^
                   ubuntu@ec2-13-61-34-125.eu-north-1.compute.amazonaws.com:/opt/tomcat/apps/

                   rem Clean up the key file
                   del "%TEMP_KEY%"
                   '''
               }
           }
       }

    }

}

