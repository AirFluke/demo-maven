pipeline{
agent any

    stages{
        stage("Git Checkout"){
            steps{
                checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/master']], extensions: [], gitTool: 'Default', userRemoteConfigs: [[credentialsId: 'git_login', url: 'https://github.com/AirFluke/demo-maven.git']])
            }
        }

        stage("Validate"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn validate"
                }
            }

        }
        stage("compile"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn compile"
                }
            }

        }
        stage("test"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn test"
                }
            }
        }
        stage('SonarQube Analysis') {
            environment{
                sonarScan = tool "airfluke-scanner"
            }
            steps{
                withSonarQubeEnv('Airfluke-Sonarqube') {
                    bat "\"${sonarScan}\\bin\\sonar-scanner.bat\""
                }
            }

        }
        stage("package"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn package"
                }
            }

        }

        stage('Deploy to Artifactory') {
            steps {
                configFileProvider([configFile(fileId: '2f82de63-6117-45d8-a06c-7f9c93c76a5c', variable: 'MAVEN_SETTINGS')]) {
                    withMaven(
                        maven: 'Maven 3.9',
                        mavenSettingsFilePath: "${MAVEN_SETTINGS}"
                    ) {
                        bat "mvn deploy -s ${MAVEN_SETTINGS}"
                    }
                }
            }
        }
        stage('Deploy to Devvvv') {
            steps {
                configFileProvider([configFile(fileId: 'ec2-dev-key-file', variable: 'PEM_FILE')]) {
                    sshPut(
                        remote: [
                            name: 'dev-server',
                            host: 'ec2-13-61-34-125.eu-north-1.compute.amazonaws.com',
                            user: 'ubuntu',
                            identity: env.PEM_FILE
                        ],
                        from: '/target/ibt-maven-1.0-SNAPSHOTS.jar',
                        into: '/opt/tomcat/apps/'
                    )

                    sshCommand(
                        remote: [
                            name: 'dev-server',
                            host: 'ec2-13-61-34-125.eu-north-1.compute.amazonaws.com',
                            user: 'ubuntu',
                            identity: env.PEM_FILE
                        ],
                        command: 'echo "Deployment successful!"'
                    )
                }
            }
        }

        stage('Deploy to Devv') {
            steps {
                sshPut(
                    remote: [
                        name: 'dev-server',
                        host: 'ec2-13-61-34-125.eu-north-1.compute.amazonaws.com',
                        user: 'ubuntu',
                        identity: credentials('aws-ec2-key')
                    ],
                    from: '/target/ibt-maven-1.0-SNAPSHOTS.jar',
                    into: '/opt/tomcat/apps/'
                )

                sshCommand(
                    remote: [
                        name: 'dev-server',
                        host: 'ec2-13-61-34-125.eu-north-1.compute.amazonaws.com',
                        user: 'ubuntu',
                        identity: credentials('aws-ec2-key')
                    ],
                    command: 'echo "Deployment successful!"'
                )
            }
        }

        stage("Deploy to Dev"){
            steps{
                sshPut remote: [
                            name: "ubuntu",
                            host: "ec2-13-61-34-125.eu-north-1.compute.amazonaws.com",
                            user: "ubuntu",
                            identity: "C:\\ProgramData\\Jenkins\\.jenkins\\workspace\\Airfluke\\demo-deploy.pem",
                            allowAnyHosts: true
                        ],
                        from: 'target/ibt-maven-1.0-SNAPSHOTS.jar',
                        into: '/opt/tomcat/apps/'

            }
        }

    }

}

