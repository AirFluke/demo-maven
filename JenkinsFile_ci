pipeline{
agent any

    stages{
        stage("Git Checkout"){
            steps{
                checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/master']], extensions: [], gitTool: 'Default', userRemoteConfigs: [[credentialsId: 'git_login', url: 'https://github.com/AirFluke/demo-maven.git']])
            }
        }

        stage("Validate"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn validate"
                }
            }

        }
        stage("compile"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn compile"
                }
            }

        }
        stage("test"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn test"
                }
            }
        }
        stage('SonarQube Analysis') {
            environment{
                sonarScan = tool "airfluke-scanner"
            }
            steps{
                withSonarQubeEnv(credentialsId: 'sonar-jenkins', installationName: 'Airfluke-Sonarqube') {
                    bat """
                                "${sonarScan}\\bin\\sonar-scanner.bat" ^
                                  -Dsonar.projectKey=Airfluke_sonarqube ^
                                  -Dsonar.projectName=Airfluke_sonarqube ^
                                  -Dsonar.sources=. ^
                                  -Dsonar.host.url=http://localhost:9000 ^
                                  -Dsonar.login=%SONAR_TOKEN%
                                """
                }
            }

        }
    }

}