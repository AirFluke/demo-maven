pipeline{
agent any

    stages{
        stage("Git Checkout"){
            steps{
                checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/master']], extensions: [], gitTool: 'Default', userRemoteConfigs: [[credentialsId: 'git_login', url: 'https://github.com/AirFluke/demo-maven.git']])
            }
        }

        stage("Validate"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn validate"
                }
            }

        }
        stage("compile"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn compile"
                }
            }

        }
        stage("test"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn test"
                }
            }
        }
        stage('SonarQube Analysis') {
            environment{
                sonarScan = tool "airfluke-scanner"
            }
            steps{
                withSonarQubeEnv('Airfluke-Sonarqube') {
                    bat "\"${sonarScan}\\bin\\sonar-scanner.bat\""
                }
            }

        }
        stage("package"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn package"
                }
            }

        }

        stage('Deploy to Artifactory') {
            steps {
                configFileProvider([configFile(fileId: '2f82de63-6117-45d8-a06c-7f9c93c76a5c', variable: 'MAVEN_SETTINGS')]) {
                    withMaven(
                        maven: 'Maven 3.9',
                        mavenSettingsFilePath: "${MAVEN_SETTINGS}"
                    ) {
                        bat "mvn deploy -s ${MAVEN_SETTINGS}"
                    }
                }
            }
        }


       stage('Deploy to Dev') {
           steps {
               withCredentials([sshUserPrivateKey(credentialsId: 'aws-ec2-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'USERNAME')]) {
                   bat """
                   "C:\\Program Files\\Git\\bin\\bash.exe" -c "chmod 600 ${SSH_KEY} && scp -o StrictHostKeyChecking=no -i ${SSH_KEY} target/ibt-maven-1.0-SNAPSHOTS.jar ${USERNAME}@13.61.34.125:/opt/tomcat/apps/"
                   """
               }
       }


    }

}

