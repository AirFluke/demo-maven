pipeline{
agent any

    stages{
        stage("Git Checkout"){
            steps{
                checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/master']], extensions: [], gitTool: 'Default', userRemoteConfigs: [[credentialsId: 'git_login', url: 'https://github.com/AirFluke/demo-maven.git']])
            }
        }

        stage("Validate"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn validate"
                }
            }

        }
        stage("compile"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn compile"
                }
            }

        }
        stage("test"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn test"
                }
            }
        }
        stage('SonarQube Analysis') {
            environment{
                sonarScan = tool "airfluke-scanner"
            }
            steps{
                withSonarQubeEnv('Airfluke-Sonarqube') {
                    bat "\"${sonarScan}\\bin\\sonar-scanner.bat\""
                }
            }

        }
        stage("package"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn package"
                }
            }

        }

        stage("deploy-to-artifactory"){
            steps{
                configFileProvider([configFile(fileId: 'maven-settings-xml', targetLocation: 'mvn_settings_config', variable: 'mvn_settings_config')]) {
                     withMaven(maven: 'Maven 3.9') {
                        bat "mvn deploy -s $settings-xml"
                     }
                }
            }
        }


        }

    }

