pipeline{
agent any

    stages{
        stage("Git Checkout"){
            steps{
                checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/master']], extensions: [], gitTool: 'Default', userRemoteConfigs: [[credentialsId: 'git_login', url: 'https://github.com/AirFluke/demo-maven.git']])
            }
        }

        stage("Validate"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn validate"
                }
            }

        }
        stage("compile"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn compile"
                }
            }

        }
        stage("test"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn test"
                }
            }
        }
        stage('SonarQube Analysis') {
            environment{
                sonarScan = tool "airfluke-scanner"
            }
            steps{
                withSonarQubeEnv('Airfluke-Sonarqube') {
                    bat "\"${sonarScan}\\bin\\sonar-scanner.bat\""
                }
            }

        }
        stage("package"){
            steps{
                withMaven(maven: 'Maven 3.9') {
                    bat "mvn package"
                }
            }

        }
        stage('Dependency Check -Vulenerability Scans ') {
            steps {
                dependencyCheck additionalArguments: '''
                    -o "./"
                    -s "./"
                    -f "ALL"
                    --prettyprint ''' , odcInstallation: "dependency-check"
                dependencyCheckPublisher pattern: 'dependency-check-report.xml'
            }
        }
        stage("deploy-to-artifactory"){
            steps{
                withCredentials([file(credentialsId: 'maven-settings-xml-file', variable: 'setttings-xml')]) {
                     withMaven(maven: 'Maven 3.9') {
                        bat "mvn deploy -s $setttings-xml"
                     }
            }
        }


        }

    }

}